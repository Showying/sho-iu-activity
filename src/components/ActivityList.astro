---
import { getCollection } from 'astro:content';
import Gallery from './Gallery.astro';

// 年の降順で取得
const allActivities = (await getCollection('activities')).sort(
	(a, b) => b.data.year - a.data.year
);
---

<section class="activities-section section">
  <div class="container">
    <h2 class="section-title">Activity Timeline</h2>
    
    <div class="timeline">
      {allActivities.map(async (activity) => {
        const { Content } = await activity.render();
        return (
          <article class="activity-card" id={`year-${activity.data.year}`}>
            <div class="year-label">
              <span class="year-number">{activity.data.year}</span>
            </div>
            
            <div class="activity-content">
              <div class="summary-box">
                <h3 class="year-header">{activity.data.year} Summary</h3>
                <p class="summary-text">{activity.data.summary}</p>
              </div>

              <!-- Gallery Component (Marquee UI preserved) -->
              <Gallery year={activity.data.year} />

              <div class="details-body">
                <Content />
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .activities-section {
    background-color: var(--color-bg-secondary); /* Light gray background */
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    padding: var(--spacing-xl) 0;
  }

  /* Container override to keep content centered */
  .container {
    max-width: 1024px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  .timeline {
    position: relative;
    max-width: 900px;
    margin: 0 auto;
  }
  
  /* Vertical Line */
  .timeline::before {
    content: '';
    position: absolute;
    left: 20px;
    top: 0;
    bottom: 0;
    width: 4px; /* Thicker line */
    background-color: rgba(0, 0, 0, 0.05);
    border-radius: 4px;
  }
  
  @media (min-width: 768px) {
    .timeline::before {
      left: -40px;
    }
  }

  .activity-card {
    position: relative;
    margin-bottom: var(--spacing-xl);
    padding-left: 60px; /* Increased space */
  }

  @media (min-width: 768px) {
    .activity-card {
      padding-left: 0;
    }
  }

  .year-label {
    position: absolute;
    left: 0;
    top: -10px;
    width: 60px;
    height: 60px;
    background-color: var(--color-primary);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    z-index: 2;
    box-shadow: 0 4px 10px rgba(0,0,0,0.2);
    border: 4px solid var(--color-bg-secondary); /* Match bg color for cutout effect */
  }
  
  @media (min-width: 768px) {
    .year-label {
      left: -69px;
      width: 80px;
      height: 80px;
    }
  }

  .year-number {
    font-size: 1.1rem;
    font-family: var(--font-heading);
    color: white;
    letter-spacing: -0.02em;
  }
  
  @media (min-width: 768px) {
    .year-number {
      font-size: 1.5rem;
    }
  }

  /* Activity Content Blocks - Card Style */
  .activity-content {
    background: white;
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    overflow: hidden;
    padding: 0;
  }

  .summary-box {
    background-color: white;
    padding: var(--spacing-lg);
    border-bottom: 1px solid var(--color-border);
  }

  .year-header {
    font-size: 1.5rem; /* Larger magnitude */
    color: var(--color-primary);
    margin-bottom: var(--spacing-sm);
    font-family: var(--font-heading);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .summary-text {
    color: var(--color-text);
    line-height: 1.8;
    font-size: 1.05rem;
  }

  .details-body {
    padding: var(--spacing-lg);
  }

  /* Markdown Styles inside Activity */
  .details-body :global(h4) {
    font-size: 1.25rem;
    color: var(--color-primary);
    margin-top: 1.5rem;
    margin-bottom: 1rem;
    border-left: 4px solid var(--color-accent);
    padding-left: 1rem;
    font-weight: 700;
    border-bottom: none; /* Removed dashed line */
  }

  .details-body :global(ul) {
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .details-body :global(li) {
    margin-bottom: 0.75rem;
    color: var(--color-text);
    line-height: 1.7;
  }
  
  .details-body :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    font-weight: 500;
  }
</style>
