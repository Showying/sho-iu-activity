---
import fs from "node:fs";
import path from "node:path";

interface Props {
  year: number;
}

const { year } = Astro.props;

// 画像ディレクトリパス (publicフォルダからの相対パス)
const imageDirRel = `images/${year}`;
// システム上の絶対パス
const imageDirAbs = path.join(process.cwd(), "public", imageDirRel);

let images: string[] = [];

// ファイルを再帰的に取得する関数
function getImagesRecursively(dir: string): string[] {
  let results: string[] = [];

  if (!fs.existsSync(dir)) return results;

  const list = fs.readdirSync(dir);
  list.forEach((file) => {
    const filePath = path.join(dir, file);
    const stat = fs.statSync(filePath);
    if (stat && stat.isDirectory()) {
      results = results.concat(getImagesRecursively(filePath));
    } else {
      if (/\.(jpg|jpeg|png|webp|gif|avif|svg)$/i.test(file)) {
        results.push(filePath);
      }
    }
  });
  return results;
}

try {
  if (fs.existsSync(imageDirAbs)) {
    const allFiles = getImagesRecursively(imageDirAbs);

    // 絶対パスからWeb用のパスに変換
    images = allFiles.map((filePath) => {
      const relativePath = path.relative(
        path.join(process.cwd(), "public"),
        filePath,
      );
      return "/" + relativePath.split(path.sep).join("/");
    });
  }
} catch (e) {
  console.error(`Error reading image directory for year ${year}:`, e);
}

// 行数決定ロジック
let lanes: string[][] = [];
if (images.length > 0) {
  if (images.length <= 6) {
    lanes = [images];
  } else if (images.length <= 15) {
    // 2行に分割
    const mid = Math.ceil(images.length / 2);
    lanes = [images.slice(0, mid), images.slice(mid)];
  } else {
    // 3行に分割
    const third = Math.ceil(images.length / 3);
    lanes = [
      images.slice(0, third),
      images.slice(third, third * 2),
      images.slice(third * 2),
    ];
  }
}
---

{
  images.length > 0 && (
    <div class="gallery-container">
      <h3 class="gallery-title">
        {year} Gallery ({images.length} Photos)
      </h3>
      <div class="marquee-wrapper">
        {lanes.map((laneImages, i) => (
          <div class={`marquee-lane lane-${i + 1}`}>
            <div class="marquee-content">
              {/* ループのために2セット描画 */}
              {laneImages.map((src, index) => (
                <div class="gallery-item">
                  <img
                    src={src}
                    alt={`${year} activity ${index}`}
                    loading="lazy"
                  />
                </div>
              ))}
              {laneImages.map((src, index) => (
                <div class="gallery-item">
                  <img
                    src={src}
                    alt={`${year} activity ${index} duplicate`}
                    loading="lazy"
                  />
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  )
}

<style>
  .gallery-container {
    margin: 2rem 0;
    overflow: hidden; /* 横スクロールバーを出さない */
    position: relative;
    /* 右側のフェードアウト効果 */
    mask-image: linear-gradient(
      to right,
      transparent,
      black 10%,
      black 90%,
      transparent
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 10%,
      black 90%,
      transparent
    );
  }

  .gallery-title {
    font-size: 0.875rem;
    color: var(--color-text-light);
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-left: 2px solid var(--color-accent);
    padding-left: 0.5rem;
    margin-left: 1rem;
  }

  .marquee-wrapper {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .marquee-lane {
    display: flex;
    overflow: hidden;
    user-select: none;
    width: 100%; /* 幅を明示 */
  }

  .marquee-content {
    display: flex;
    gap: 16px;
    animation: scroll 40s linear infinite;
    /* 画像の幅に応じて自動で幅が決まる */
    width: max-content;
    flex-wrap: nowrap; /* 強制的に1列にする */
  }

  /* 速度の変化のみつける（方向はすべて統一） */
  .lane-1 .marquee-content {
    animation-duration: 60s;
  }
  .lane-2 .marquee-content {
    animation-duration: 75s;
  }
  .lane-3 .marquee-content {
    animation-duration: 65s;
  }

  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    } /* 2セットあるので50%移動でループ */
  }

  .gallery-item {
    flex: 0 0 auto;
    width: 280px; /* 固定幅 */
    height: 180px; /* 固定高さ */
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    background-color: #f0f0f0;
  }

  @media (max-width: 768px) {
    .gallery-item {
      width: 200px;
      height: 130px;
    }
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .gallery-item:hover img {
    transform: scale(1.05);
  }
</style>
