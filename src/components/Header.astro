---

---

<header class="header">
  <div class="container header-inner">
    <div class="logo-group">
      <a href={import.meta.env.BASE_URL} class="logo">Sho T Lab.</a>
      <span class="subtitle"
        >iU情報経営イノベーション専門職大学 客員教授 活動実績</span
      >
    </div>
  </div>
</header>

<style>
  .header {
    padding: var(--spacing-md) 0;
    border-bottom: 1px solid var(--color-border);
    background-color: rgba(255, 255, 255, 0.95);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(5px);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  @media (min-width: 768px) {
    .logo-group {
      flex-direction: row;
      align-items: center; /* better alignment with border */
      gap: 1.5rem; /* Increased spacing */
    }

    .subtitle {
      font-size: 0.85rem;
      border-left: 1px solid var(--color-border); /* Subtle separator */
      padding-left: 1.5rem; /* Space inside the separator */
      line-height: 1;
      height: 1em; /* Match line height for cleaner look */
      display: flex;
      align-items: center;
    }
  }

  .logo {
    font-size: 1.25rem;
    font-weight: 800; /* Bolder for the main brand */
    color: var(--color-primary);
    letter-spacing: 0.05em;
    text-decoration: none;
  }

  .subtitle {
    font-size: 0.7rem;
    color: var(--color-text-light);
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  @media (min-width: 768px) {
    .subtitle {
      font-size: 0.85rem;
    }
  }
</style>
